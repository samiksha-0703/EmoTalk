# Template of environment variables required by the EmoTalk backend.
# Copy this file to `.env` in the same directory and fill in your own values.
# Never put real secrets in this example file.

# Google Gemini API key (get one from https://aistudio.google.com/app/apikey)
GEMINI_API_KEY=

# Optional overrides (defaults are applied in app/core/config.py if unset):
# JWT_EXPIRATION_MINUTES=1440
# ENVIRONMENT=development
#
# REQUIRED for persistent sessions — generate a secure random value with:
#   python -c "import secrets; print(secrets.token_hex(32))"
# Without this, all user sessions are lost every time the server restarts.
# JWT_SECRET_KEY=your-generated-secret-here
#
# Model selection — which emotion recognition model to use:
#   huggingface  (default) wav2vec2 from HuggingFace — downloads ~360MB on first run
#   custom                 your locally-trained CNN+LSTM — requires backend/models/*.h5 + *.pkl
# MODEL_TYPE=huggingface
#
# Allowed frontend origins for CORS (comma-separated).
# Dev defaults (localhost:5173 / 3000) are used when this is unset.
# Set this in production to your actual frontend URL:
# CORS_ORIGINS=https://emotalk.yourdomain.com

# ── FFmpeg ────────────────────────────────────────────────────────────────────
# FFmpeg is required for audio format conversion (webm → wav, mp3 → wav, etc.).
#
# Option A (recommended): Install FFmpeg and add it to your system PATH.
#   • Windows: https://www.gyan.dev/ffmpeg/builds/ → add bin/ to PATH
#   • Mac:     brew install ffmpeg
#   • Linux:   sudo apt install ffmpeg
#
# Option B: Set explicit paths below (only needed if FFmpeg is NOT on PATH).
# FFMPEG_PATH=C:\ffmpeg\bin\ffmpeg.exe
# FFPROBE_PATH=C:\ffmpeg\bin\ffprobe.exe
